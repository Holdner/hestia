<div class="<%= cn("flex min-w-0 flex-col", @class_name) %>">
  <%# Wraps: in a half-width card on a phone, the badge drops under the label
      instead of pushing out of the card or crushing the label to one word a line. %>
  <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
    <p class="text-sm text-secondary"><%= @label %></p>
    <% if badge? %><div class="min-w-0 max-w-full"><%= badge %></div><% end %>
  </div>
  <p class="hero-amount mt-1"><%= @value %></p>
  <% if support? %><p class="mt-1 text-sm tabular-nums text-support-figure"><%= support %></p><% end %>
  <% if gauge? %><div class="mt-3"><%= gauge %></div><% end %>
</div>
