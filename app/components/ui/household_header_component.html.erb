<div class="<%= cn("rounded-lg overflow-hidden border border-primary bg-container", @class_name) %>">
  <div class="relative flex items-center justify-center bg-surface-inset" style="height: <%= @height %>px">
    <% if photo? %>
      <%= photo %>
    <% else %>
      <span class="text-sm text-subdued">Ajoutez une photo du foyer</span>
    <% end %>
  </div>

  <%# Wraps rather than squeezes: on a phone the name used to be crushed to
      "F…" by the avatars and the action beside it. The name keeps at least
      basis-40 and the avatars + action drop, together, to a line of their own. %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3 px-5 py-4">
    <div class="min-w-0 grow basis-40">
      <h2 class="text-xl font-semibold tracking-[-0.02em] text-primary truncate"><%= @name %></h2>
      <% if @note %><p class="text-sm text-secondary mt-0.5"><%= @note %></p><% end %>
    </div>

    <% if @members.any? || action? %>
      <div class="flex items-center gap-4">
        <% if @members.any? %><%= render Ui::AvatarGroupComponent.new(members: @members, max: 5) %><% end %>
        <% if action? %><%= action %><% end %>
      </div>
    <% end %>
  </div>
</div>
