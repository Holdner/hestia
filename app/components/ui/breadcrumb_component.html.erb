<%# data-breadcrumb is not styling: visual:check excludes the links of a
    breadcrumb trail from its touch-target rule (they are read, not aimed at),
    and matching on the aria-label would mean matching on a translated string. %>
<nav aria-label="<%= t("ui.breadcrumb.nav_aria") %>" data-breadcrumb>
  <%# flex-wrap + whitespace-nowrap on the ancestors: on a phone the trail
      used to break inside a crumb ("Tableau de / bord"). A crumb now moves to
      the next line whole; only the current page, last, may wrap its own label. %>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm">
    <% @items.each_with_index do |(label, href), index| %>
      <li class="<%= href ? "flex items-center gap-1.5 whitespace-nowrap" : "flex min-w-0 items-center gap-1.5" %>">
        <% if href %>
          <%= link_to label, href, class: "text-secondary hover:text-primary" %>
          <span class="text-subdued" aria-hidden="true">/</span>
        <% else %>
          <span class="text-primary font-medium" aria-current="page"><%= label %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
