<% if segmented? %>
  <%# Same tab-group look as the Budget's Mensuel / Annuel switch. Which one is
      pressed lives in localStorage, so the theme controller sets aria-pressed
      on connect and the aria-pressed: variants do the styling. %>
  <div data-controller="theme" role="group" aria-label="<%= t("ui.theme_toggle.group_aria") %>"
    class="inline-flex flex-wrap gap-1 rounded-md bg-tab-group p-1">
    <% CHOICES.each do |choice| %>
      <button type="button" data-theme-target="choice" data-theme-choice-param="<%= choice %>" data-action="click->theme#choose"
        aria-pressed="false"
        class="flex h-[var(--control-h-sm)] cursor-pointer items-center gap-1.5 whitespace-nowrap rounded-md px-3 text-sm font-medium text-secondary transition-colors hover:text-primary aria-pressed:bg-tab-item-active aria-pressed:text-primary aria-pressed:shadow-border-xs">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <%= icon_paths(choice) %>
        </svg>
        <%= t("ui.theme_toggle.#{choice}") %>
      </button>
    <% end %>
  </div>
<% else %>
<button type="button" data-controller="theme" data-action="click->theme#cycle"
  class="inline-flex size-9 items-center justify-center rounded-md text-secondary hover:bg-surface-hover hover:text-primary transition-colors"
  aria-label="Thème actuel : clair. Cliquer pour changer de thème.">
  <span data-theme-target="option" data-theme="light">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" />
      <path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
    </svg>
  </span>
  <span data-theme-target="option" data-theme="dark" hidden>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
    </svg>
  </span>
  <span data-theme-target="option" data-theme="system" hidden>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="14" x="2" y="3" rx="2" /><line x1="8" x2="16" y1="21" y2="21" /><line x1="12" x2="12" y1="17" y2="21" />
    </svg>
  </span>
</button>
<% end %>
