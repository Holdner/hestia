<%= content_tag(@href ? :a : :div, href: @href,
    "aria-current": (@active ? "page" : nil),
    class: cn(
      # py-2 + min-h-11, where this used to carry py-2.5: 10px is off the 4px
      # grid, and after the design-system pages it was the largest single
      # source of spacing_scale findings in visual:check. Padding alone could
      # not fix it without moving every list in the app — py-2 on its own
      # shortens a one-line row from 44px to 40px, py-3 lengthens it to 48px.
      # The floor keeps that common case pixel-identical at 44px while putting
      # the padding back on the grid, and lifts a row whose content is shorter
      # than a line of text (an icon-only row) to 44px rather than leaving it
      # under the 36px touch-target floor.
      "on-tone flex min-h-11 flex-wrap items-center gap-x-3 gap-y-2 rounded-md py-2 px-3 transition-colors",
      @active ? "bg-item-active" : (@href ? "hover:bg-surface-hover cursor-pointer" : nil)
    )) do %>
  <% if leading? %><div class="shrink-0"><%= leading %></div><% end %>
  <%# grow + basis-40 rather than flex-1: with a basis of 0 the text gave way
      to any number of trailing actions, down to an empty column on a phone
      (the fridge rows showed no name at all). Now the text keeps 10rem and the
      trailing block wraps under it, pushed right by ml-auto. %>
  <div class="min-w-0 grow basis-40">
    <% if title? %><p class="<%= cn("text-base text-primary", @active ? "font-semibold" : "font-medium", @truncate && "truncate") %>"><%= title %></p><% end %>
    <% if description? %><p class="<%= cn("text-sm text-secondary", @truncate && "truncate") %>"><%= description %></p><% end %>
  </div>
  <% if trailing? %><div class="ml-auto shrink-0"><%= trailing %></div><% end %>
<% end %>
