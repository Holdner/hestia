<% if line? %>
  <div class="w-full <%= color_class %>" style="height: <%= @height %>px">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="h-full w-full" role="img" aria-label="<%= @data.map { |label, value| "#{label} : #{value}" }.join(", ") %>">
      <polyline points="<%= line_points %>" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
  <div class="mt-1 flex justify-between text-xs text-secondary">
    <% @data.each do |label, _| %><span><%= label %></span><% end %>
  </div>
<% else %>
  <%# Bars and labels are two rows sharing one column grid (same flex-1 and
      gap), not one column each holding both. A label used to sit inside its
      bar's 32px column, so « Alimentation » spilled over its neighbours, and
      the bar's height was a share of a box that also held the label. %>
  <div class="flex items-end gap-3" style="height: <%= @height %>px">
    <% @data.each_with_index do |(label, value), index| %>
      <div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end">
        <div class="w-full max-w-12 rounded-t-sm <%= COLORS[index % COLORS.size] %>" style="height: <%= (value / @max * 100).round(2) %>%" role="img" aria-label="<%= label %> : <%= value %>"></div>
      </div>
    <% end %>
  </div>
  <% if @data.any? %>
    <div class="mt-2 flex gap-3">
      <% @data.each do |label, _| %>
        <span class="min-w-0 flex-1 truncate text-center text-xs text-secondary" title="<%= label %>"><%= label %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
