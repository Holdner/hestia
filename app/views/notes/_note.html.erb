<% filter_params = { q: query.presence, archived: (archived ? 1 : nil) } %>
<%= tag.div id: dom_id(note) do %>
  <%= render(Ui::CardComponent.new(class_name: note_card_color_class(note.color))) do %>
    <div class="flex flex-col">
      <%# Three icons, not a row of five buttons: the favourite star (filled
          when on) and the pencil stay in reach, the rest sits behind « … ».
          The menu confirms through the global dialog, as the AlertDialogs it
          replaces did, and says « Convertir » in neutral, not a red Confirmer. %>
      <div class="mb-1 flex items-start justify-between gap-2">
        <h2 class="min-w-0 pt-2 font-medium"><%= note.title %></h2>
        <div class="-mr-2 flex shrink-0 items-center">
          <%= render(Ui::ButtonToComponent.new(toggle_favorite_note_path(note, **filter_params), method: :patch, variant: :ghost, size: :icon,
                html_options: { aria: { label: note.favorite ? t(".unfavorite") : t(".favorite"), pressed: note.favorite } })) {
                lucide_icon("star", css_class: "size-4 #{"fill-current" if note.favorite}") } %>
          <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon, href: edit_note_path(note),
                html_options: { aria: { label: t(".edit_aria", title: note.title) } })) { lucide_icon("pencil", css_class: "size-4") } %>
          <%= render(Ui::DropdownMenuComponent.new) do |menu| %>
            <% menu.with_trigger do %>
              <%= render(Ui::ButtonComponent.new(variant: :ghost, size: :icon,
                    html_options: { aria: { label: t(".more_actions_aria", title: note.title) } })) { lucide_icon("ellipsis", css_class: "size-4") } %>
            <% end %>
            <%= button_to note.archived ? t(".unarchive") : t(".archive"), toggle_archive_note_path(note, **filter_params),
                  method: :patch, **Ui::DropdownMenuComponent.item_options %>
            <%= button_to t(".promote_to_task"), promote_to_task_note_path(note, **filter_params), method: :post,
                  form: { data: { turbo_confirm: t(".promote_confirm"), turbo_confirm_label: t(".promote_confirm_label"), turbo_confirm_variant: "default" } },
                  **Ui::DropdownMenuComponent.item_options %>
            <%= button_to t(".promote_to_shopping"), promote_to_shopping_list_item_note_path(note, **filter_params), method: :post,
                  form: { data: { turbo_confirm: t(".promote_to_shopping_confirm"), turbo_confirm_label: t(".promote_to_shopping_confirm_label"), turbo_confirm_variant: "default" } },
                  **Ui::DropdownMenuComponent.item_options %>
            <%= Ui::DropdownMenuComponent.separator %>
            <%= button_to t(".delete"), note_path(note, **filter_params), method: :delete,
                  form: { data: { turbo_confirm: t(".delete_confirm"), turbo_confirm_label: t(".delete") } },
                  **Ui::DropdownMenuComponent.item_options(destructive: true) %>
          <% end %>
        </div>
      </div>
      <% if note.content.present? %>
        <div class="mb-3 line-clamp-4 space-y-1 text-sm text-secondary"><%= format_note_content(note.content) %></div>
      <% end %>
      <% if note.recipe || note.document %>
        <div class="mb-3 flex flex-wrap gap-3 text-xs">
          <% if note.recipe %>
            <%= link_to recipe_path(note.recipe), class: "inline-flex items-center gap-1 text-link hover:underline" do %><%= lucide_icon("book-open", css_class: "size-3.5") %> <%= note.recipe.title %><% end %>
          <% end %>
          <% if note.document %>
            <%= link_to document_path(note.document), class: "inline-flex items-center gap-1 text-link hover:underline" do %><%= lucide_icon("paperclip", css_class: "size-3.5") %> <%= note.document.name %><% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
