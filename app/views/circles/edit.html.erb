<% content_for :title, t(".title", name: @circle.name) %>

<div class="mx-auto mt-10 max-w-xl px-4">
  <div class="mb-4"><%= module_breadcrumb(:circles, [ @circle.name, circle_path(@circle) ], [ t("circles.show.settings"), nil ], module_path: circles_path) %></div>

  <h1 class="mb-6 text-2xl font-semibold"><%= t(".title", name: @circle.name) %></h1>

  <%= render "shared/flash" %>

  <%= render(Ui::CardComponent.new(class_name: "mb-6")) do |card| %>
    <% card.with_title { t(".details") } %>
    <%= form_with model: @circle, url: circle_path(@circle), method: :patch, class: "space-y-3" do |form| %>
      <%= render Ui::InputComponent.new(name: "circle[name]", value: @circle.name,
            html_options: { id: "circle_name", required: true }) %>
      <%= render Ui::InputComponent.new(name: "circle[theme]", value: @circle.theme, placeholder: t("circles.index.theme_placeholder"),
            html_options: { id: "circle_theme" }) %>
      <%= render(Ui::ButtonComponent.new(type: "submit")) { t(".save") } %>
    <% end %>
  <% end %>

  <%= render(Ui::CardComponent.new(class_name: "mb-6")) do |card| %>
    <% card.with_title { t(".invite_code") } %>
    <p class="mb-2 text-sm text-secondary"><%= t(".invite_code_description") %></p>
    <div class="flex items-center gap-2">
      <code id="circle_invite_code" class="rounded bg-surface-inset px-3 py-1 font-semibold tracking-widest"><%= @circle.invite_code %></code>
      <%= render(Ui::CopyButtonComponent.new(value: @circle.invite_code, label: t("circles.copy_code"))) %>
    </div>
    <%= render(Ui::ButtonToComponent.new(regenerate_invite_code_circle_path(@circle), method: :post, variant: :outline, size: :sm,
          html_options: { form: { data: { turbo_confirm: t(".regenerate_confirm") }, class: "mt-3" } })) { t(".regenerate") } %>
  <% end %>

  <%= render(Ui::CardComponent.new(class_name: "mb-6")) do |card| %>
    <% card.with_title { t(".members") } %>
    <div class="divide-y divide-primary">
      <% @circle.circle_memberships.includes(:user).order(:role).each do |membership| %>
        <%= render(Ui::ItemComponent.new) do |item| %>
          <% item.with_leading { render(Ui::AvatarComponent.new(alt: membership.user.name.presence || membership.user.email_address, tint: membership.user.avatar_tint)) } %>
          <% item.with_title { membership.user.name.presence || membership.user.email_address } %>
          <% item.with_description { t("circles.roles.#{membership.role}") } %>
          <% if membership.user != Current.user %>
            <% item.with_trailing do %>
              <div class="flex items-center gap-2">
                <%= form_with url: circle_member_path(@circle, membership), method: :patch, class: "inline" do %>
                  <input type="hidden" name="role" value="<%= membership.role == "admin" ? "member" : "admin" %>">
                  <%= render(Ui::ButtonComponent.new(type: "submit", variant: :ghost, size: :sm)) { membership.role == "admin" ? t(".demote") : t(".promote") } %>
                <% end %>
                <%= render(Ui::ButtonToComponent.new(circle_member_path(@circle, membership), method: :delete, variant: :ghost, size: :sm,
                      html_options: { form: { data: { turbo_confirm: t(".remove_member_confirm") } } })) { t(".remove_member") } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render(Ui::CardComponent.new(class_name: "mb-6 border-destructive")) do |card| %>
    <% card.with_title { t(".danger_zone") } %>
    <%= render(Ui::ButtonToComponent.new(circle_path(@circle), method: :delete, variant: :destructive, size: :sm,
          html_options: { form: { data: { turbo_confirm: t(".delete_confirm") } } })) { t(".delete") } %>
  <% end %>
</div>
