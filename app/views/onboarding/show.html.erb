<% content_for :title, t(".title") %>

<div class="mx-auto mt-16 max-w-lg px-4">
  <h1 class="mb-2 text-2xl font-semibold"><%= t(".heading") %></h1>
  <p class="mb-6 text-secondary"><%= t(".description") %></p>

  <%= render "shared/flash" %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-primary">
      <%= render(Ui::ItemComponent.new(href: new_household_path)) do |item| %>
        <% item.with_title { t(".create_household") } %>
        <% item.with_description { t(".create_household_description") } %>
      <% end %>
    </div>

    <div class="rounded-lg border border-primary">
      <%= render(Ui::ItemComponent.new(href: new_membership_path)) do |item| %>
        <% item.with_title { t(".join_household") } %>
        <% item.with_description { t(".join_household_description") } %>
      <% end %>
    </div>
  </div>

  <%# A <div>, not a <p>: Sign out is a button_to <form>, which the HTML parser
      refuses to nest in a <p>. It closes the paragraph early and splits the
      two buttons onto separate lines. %>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-2">
    <%= render(Ui::ButtonComponent.new(variant: :outline, size: :sm, icon: "map", href: roadmap_path)) { t("roadmap.show.title") } %>
    <%= render(Ui::ButtonToComponent.new(session_path, method: :delete, variant: :outline, size: :sm)) do %>
      <%= lucide_icon("log-out", css_class: "size-4") %>
      <%= t(".sign_out") %>
    <% end %>
  </div>
</div>
