<% content_for :title, "Design system — Hestia" %>

<%= render(layout: "design_system/shell") do %>
  <h1 class="text-2xl font-semibold text-primary">Système de conception Hestia</h1>
  <p class="mt-2 text-sm text-secondary max-w-prose">
    Tokens Tailwind v4 + composants ViewComponent + Stimulus — <%= DesignSystemRegistry.all.size %> composants,
    organisés à la façon de shadcn/ui : une page par composant avec son extrait de code, et les fondations
    (couleurs, typographie, icônes) documentées séparément.
  </p>

  <div class="mt-8 flex flex-wrap gap-3">
    <% [ [ "Couleurs", design_system_colors_path ], [ "Typographie", design_system_typography_path ],
         [ "Icônes", design_system_icons_path ], [ "Illustrations", design_system_illustrations_path ],
         [ "Matière", design_system_materials_path ] ].each do |label, path| %>
      <%= render(Ui::ButtonComponent.new(variant: :outline, href: path)) { label } %>
    <% end %>
  </div>

  <div class="mt-12 space-y-10">
    <% @categories.each do |category, entries| %>
      <div>
        <h2 class="text-sm font-semibold text-primary border-b border-primary pb-2"><%= category %></h2>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
          <% entries.each do |entry| %>
            <%= link_to design_system_component_path(entry.slug), class: "group rounded-md border border-transparent p-3 hover:border-primary hover:bg-surface-hover transition-colors" do %>
              <p class="text-sm font-medium text-primary"><%= entry.name %></p>
              <p class="mt-0.5 text-xs text-secondary truncate"><%= entry.description %></p>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
